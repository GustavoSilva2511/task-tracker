{
  "name": "task-tracker",
  "version": "1.0.0",
  "description": "Um tracker de tarefas de linha de comando escrito em TypeScript sem dependências de runtime.",
  "type": "module",
  "bin": {
    "task-cli": "./bin/task-cli.mjs"
  },
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22.6.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "task-cli": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\""
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "@types/node": "^24.3.0"
  },
  "license": "MIT"
}
